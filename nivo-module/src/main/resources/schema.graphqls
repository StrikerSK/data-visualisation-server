schema {
    query: Query
}

type Query {
    nivoBarData(kind: String!, upperGroup: String!, lowerGroup: String!, month:[String], validity:[String], type: [String], year: [String], person: [String], ticketType: [String], discounted: Boolean): [NivoBarData]
    nivoLineData(kind: String!, upperGroup: String!, lowerGroup: String!, month:[String], validity:[String], type: [String], year: [String], person: [String], ticketType: [String], discounted: Boolean): [LineData]
    nivoPieData(kind: String!, grouping: String!, month:[String], validity:[String], type: [String], year: [String], person: [String], ticketType: [String], discounted: Boolean): [PieData]
}

union NivoBarData = PersonBarData | MonthBarData | ValidityBarData | SellTypeBarData | TicketBarData

type PersonBarData {
    label: String
    adults: Int
    seniors: Int
    juniors: Int
    portable: Int
    students: Int
    children: Int
}

type MonthBarData {
    label: String
    january: Int
    february: Int
    march: Int
    april: Int
    may: Int
    june: Int
    july: Int
    august: Int
    september: Int
    october: Int
    november: Int
    december: Int
}

type TicketBarData {
    label: String
    fifteen_minutes: Int
    one_day: Int
    one_day_all: Int
    two_zones: Int
    three_zones: Int
    four_zones: Int
    five_zones: Int
    six_zones: Int
    seven_zones: Int
    eight_zones: Int
    nine_zones: Int
    ten_zones: Int
    eleven_zones: Int
}

type ValidityBarData {
    label: String
    one_month: Int
    three_months: Int
    five_months: Int
    one_year: Int
}

type SellTypeBarData {
    label: String
    chip_card: Int
    paper_coupon: Int
    e_shop: Int
}

type LineData {
    id: String
    data: [Data]
}

type PieData {
    id: String
    label: String
    value: Int
}

type Data {
    x: String,
    y: Int
}